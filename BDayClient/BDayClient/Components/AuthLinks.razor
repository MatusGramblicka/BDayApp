<AuthorizeView>
    <Authorized>
        <span>User &nbsp; <b>@context.User.Identity?.Name</b> &nbsp; logged in</span>
        <a href="logout">Log out</a>
    </Authorized>
    <NotAuthorized>
        <a href="register">Register</a>
        <a href="login">Log in</a>
    </NotAuthorized>
</AuthorizeView>
