@* The create and update form for events. The submit button is enabled once something was changed and the input is valid. *@
<EditForm EditContext="_editContext" OnValidSubmit="HandleValidSubmit" class="card card-body bg-light mt-5">
    <DataAnnotationsValidator />

    <div class="form-group row">
        <label for="name" class="col-md-2 col-form-label">Name:</label>
        <div class="col-md-10">
            <InputText id="name" class="form-control" @bind-Value="Model.Name" />
            <ValidationMessage For="@(() => Model.Name)" />
        </div>
    </div>
    <div class="form-group row">
        <span id="date-label" class="col-md-2 col-form-label">Date:</span>
        <div class="col-md-10">
            @* Day and month only, like a person's birthday and name day. *@
            <DayMonthPickerNonNullable @bind-Value="Model.Date" aria-labelledby="date-label" />
            <ValidationMessage For="@(() => Model.Date)" />
        </div>
    </div>
    <AuthorizeView Roles="Administrator">
        <Authorized Context="auth">
            <div class="form-group row">
                <span class="col-md-2 col-form-label">Image:</span>
                <div class="col-md-10">
                    <ImageUpload ImageUrl="@Model.ImageUrl" OnChange="AssignImageUrl" />
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
    <div class="row">
        <div class="col-md-12 text-right">
            <button type="submit" class="btn btn-success" disabled="@(!_canSubmit || _submitting)">
                @SubmitText
            </button>
        </div>
    </div>
</EditForm>
