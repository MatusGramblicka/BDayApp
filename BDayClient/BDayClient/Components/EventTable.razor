@if (Events is null)
{
    <p>Loading events...</p>
}
else if (Events.Count == 0)
{
    <p>No events found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <AuthorizeView Roles="Administrator">
                    <Authorized>
                        <th scope="col">Image</th>
                    </Authorized>
                </AuthorizeView>
                <th scope="col">Name</th>
                <th scope="col">Date</th>
                <th scope="col">Update</th>
                <th scope="col">Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Events)
            {
                <tr>
                    <AuthorizeView Roles="Administrator">
                        <Authorized>
                            <td>
                                @if (ApiUrls.GetImageSource(ev.ImageUrl) is { } imageSource)
                                {
                                    <a href="/event/@ev.Id">
                                        <img src="@imageSource" alt="Image of @ev.Name" style="width:100px;" />
                                    </a>
                                }
                            </td>
                        </Authorized>
                    </AuthorizeView>
                    <td class="align-middle">
                        <a href="/event/@ev.Id">@ev.Name</a>
                    </td>
                    <td class="align-middle">
                        @ev.Date.ToString("dd.MM.")
                    </td>
                    <td class="align-middle">
                        <a class="btn btn-info" href="/updateEvent/@ev.Id">Update</a>
                    </td>
                    <td class="align-middle">
                        <button type="button" class="btn btn-danger"
                                @onclick="() => CallConfirmationModal(ev.Id)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <Confirmation BodyMessage="Do you want to delete this event?"
                  OnOKClicked="DeleteEvent" @ref="_confirmation" />
}
