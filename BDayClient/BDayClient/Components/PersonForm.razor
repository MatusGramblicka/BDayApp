@* The create and update form. The submit button is enabled once something was changed and the input is valid. *@
<EditForm EditContext="_editContext" OnValidSubmit="HandleValidSubmit" class="card card-body bg-light mt-5">
    <DataAnnotationsValidator />

    <div class="form-group row">
        <label for="name" class="col-md-2 col-form-label">Name:</label>
        <div class="col-md-10">
            <InputText id="name" class="form-control" @bind-Value="Model.Name" />
            <ValidationMessage For="@(() => Model.Name)" />
        </div>
    </div>
    <div class="form-group row">
        <label for="surname" class="col-md-2 col-form-label">Surname:</label>
        <div class="col-md-10">
            <InputText id="surname" class="form-control" @bind-Value="Model.Surname" />
            <ValidationMessage For="@(() => Model.Surname)" />
        </div>
    </div>
    <div class="form-group row">
        <span id="birthday-label" class="col-md-2 col-form-label">Birthday:</span>
        <div class="col-md-10">
            <DayMonthPickerNullable @bind-Value="Model.DayOfBirth" aria-labelledby="birthday-label" />
            <ValidationMessage For="@(() => Model.DayOfBirth)" />
        </div>
    </div>
    <div class="form-group row">
        <span id="nameday-label" class="col-md-2 col-form-label">Nameday:</span>
        <div class="col-md-10">
            <DayMonthPickerNonNullable @bind-Value="Model.DayOfNameDay" aria-labelledby="nameday-label" />
            <ValidationMessage For="@(() => Model.DayOfNameDay)" />
        </div>
    </div>
    <AuthorizeView Roles="Administrator">
        <Authorized Context="auth">
            <div class="form-group row">
                <span class="col-md-2 col-form-label">Image:</span>
                <div class="col-md-10">
                    <ImageUpload ImageUrl="@Model.ImageUrl" OnChange="AssignImageUrl" />
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
    <div class="row">
        <div class="col-md-12 text-right">
            <button type="submit" class="btn btn-success" disabled="@(!_canSubmit || _submitting)">
                @SubmitText
            </button>
        </div>
    </div>
</EditForm>
