@if (Persons is null)
{
    <p>Loading persons...</p>
}
else if (Persons.Count == 0)
{
    <p>No persons found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <AuthorizeView Roles="Administrator">
                    <Authorized>
                        <th scope="col">Image</th>
                    </Authorized>
                </AuthorizeView>
                <th scope="col">Name</th>
                <th scope="col">Surname</th>
                <th scope="col">Birthday</th>
                <th scope="col">Nameday</th>
                <th scope="col">Update</th>
                <th scope="col">Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var person in Persons)
            {
            <tr>
                <AuthorizeView Roles="Administrator">
                    <Authorized>
                        <td>
                            @if (ApiUrls.GetImageSource(person.ImageUrl) is { } imageSource)
                            {
                                <a href="/person/@person.Id">
                                    <img src="@imageSource" alt="Photo of @person.Name" style="width:100px;" />
                                </a>
                            }
                        </td>
                    </Authorized>
                </AuthorizeView>
                <td class="align-middle">
                    <a href="/person/@person.Id">
                        @person.Name
                    </a>
                </td>
                <td class="align-middle">
                    @person.Surname
                </td>
                <td class="align-middle">
                    @(person.DayOfBirth?.ToString("dd.MM.") ?? "")
                </td>
                <td class="align-middle">
                    @person.DayOfNameDay.ToString("dd.MM.")
                </td>
                <td class="align-middle">
                    <a class="btn btn-info" href="/updatePerson/@person.Id">
                        Update
                    </a>
                </td>
                <td class="align-middle">
                    <button type="button" class="btn btn-danger"
                            @onclick="() => CallConfirmationModal(person.Id)">
                        Delete
                    </button>
                </td>
            </tr>
            }
        </tbody>
    </table>
    <Confirmation BodyMessage="Do you want to delete this person?"
                  OnOKClicked="DeletePerson" @ref="_confirmation" />
}
