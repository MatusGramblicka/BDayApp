@if (Persons is null)
{
	<p>Loading persons...</p>
}
else if (_upcoming.Count == 0)
{
	<p>No birthdays or namedays in the next @WithinDays days.</p>
}
else
{
	<table class="table">
		<thead>
		<tr>
			<th scope="col">Image</th>
			<th scope="col">Name</th>
			<th scope="col">Surname</th>
			<th scope="col">Birthday</th>
			<th scope="col">Nameday</th>
			<th scope="col">Next</th>
		</tr>
		</thead>
		<tbody>
		@foreach (var upcoming in _upcoming)
		{
			var person = upcoming.Person;
			<tr>
				<td>
					@if (ApiUrls.GetImageSource(person.ImageUrl) is { } imageSource)
					{
						<a href="/person/@person.Id">
							<img src="@imageSource" alt="Photo of @person.Name" style="width:100px;" />
						</a>
					}
				</td>
				<td class="align-middle">
					<a href="/person/@person.Id">
						@person.Name
					</a>
				</td>
				<td class="align-middle">
					@person.Surname
				</td>
				<td class="align-middle">
					@(person.DayOfBirth?.ToString("dd.MM.") ?? "")
				</td>
				<td class="align-middle">
					@person.DayOfNameDay.ToString("dd.MM.")
				</td>
				<td class="align-middle">
					@upcoming.Description
				</td>
			</tr>
		}
		</tbody>
	</table>
}
