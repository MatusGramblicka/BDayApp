@if (Users is null)
{
    <p>Loading users...</p>
}
else if (Users.Count == 0)
{
    <p>No users found.</p>
}
else
{
    @* https://blazor.radzen.com/switch
       The page reloads the users after every change, so a change the server refuses flips its switch back. *@
    <table class="table">
        <thead>
            <tr>
                <th scope="col">User</th>
                <th scope="col">Admin role</th>
                <th scope="col">Delete user</th>
                <th scope="col">Enable 2 factor auth</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Users)
            {
            <tr>
                <td class="align-middle">
                    @user.Email
                </td>
                <td class="align-middle">
                    @* On gives the user the administrator role, off removes it. Your own role can't be changed:
                       the server refuses that, as it refuses removing the last administrator. *@
                    <RadzenSwitch @bind-Value=@user.IsAdmin
                                  Disabled="@IsLoggedUser(user)"
                                  title="@(IsLoggedUser(user) ? "You cannot change your own administrator role" : null)"
                                  aria-label="@($"Administrator role for {user.Email}")"
                                  Change=@(isAdmin => OnAdminRoleChange(isAdmin, user)) />
                </td>
                <td class="align-middle">
                    <button type="button" class="btn btn-danger"
                            @onclick="() => CallConfirmationModal(user)" disabled="@IsLoggedUser(user)">
                        Delete User
                    </button>
                </td>
                <td class="align-middle">
                    <RadzenSwitch @bind-Value=@user.TwoFactorEnabled
                                  aria-label="@($"Two-factor authentication for {user.Email}")"
                                  Change=@(enabled => OnTwoFactorChange(enabled, user)) />
                </td>
            </tr>
            }
        </tbody>
    </table>
    <Confirmation BodyMessage="Do you want to delete this user?"
                  OnOKClicked="DeleteUser" @ref="_confirmation" />
}
