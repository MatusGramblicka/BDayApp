@page "/404"

<PageTitle>Not found - BDay App</PageTitle>

<div class="card customNotFound">
    <div class="card-body">
        <div class="col">
            We are sorry, but we couldn't find the page you are looking for!
        </div>
    </div>
</div>
<div class="row">
    <div class="col text-md-center m-5 text-primary">
        <AuthorizeView>
            <Authorized>
                <a class="btn btn-primary" href="/persons">Back to the persons</a>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-primary" href="/login">Go to the login page</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>
