@page "/event/{id:guid}"
@attribute [Authorize]

<PageTitle>@(_event is null ? "Event" : _event.Name) - BDay App</PageTitle>

@if (_event is not null)
{
    <div class="card">
        <div class="card-body">
            <div class="row">
                <AuthorizeView Roles="Administrator">
                    <Authorized>
                        @if (ApiUrls.GetImageSource(_event.ImageUrl) is { } imageSource)
                        {
                            <div class="col-md-4">
                                <img class="event-image" src="@imageSource" alt="Image of @_event.Name" />
                            </div>
                        }
                    </Authorized>
                </AuthorizeView>
                <div class="col-md-8">
                    <div class="row">
                        <div class="col">
                            <h3 class="event-title">@_event.Name</h3>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <span class="event-description">Date: @_event.Date.ToString("dd.MM.")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (_loadFailed)
{
    <p>The event could not be loaded.</p>
}
else
{
    <p>Loading event...</p>
}
<br />
<div class="row">
    <div class="col">
        <a href="/events" class="btn btn-success">Back</a>
    </div>
</div>
