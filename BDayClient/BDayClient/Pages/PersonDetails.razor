@page "/person/{personId:guid}"
@attribute [Authorize]

<PageTitle>@(_person is null ? "Person" : $"{_person.Name} {_person.Surname}".Trim()) - BDay App</PageTitle>

@if (_person is not null)
{
    <div class="card">
        <div class="card-body">
            <div class="row">
                <AuthorizeView Roles="Administrator">
                    <Authorized>
                        @if (ApiUrls.GetImageSource(_person.ImageUrl) is { } imageSource)
                        {
                            <div class="col-md-4">
                                <img class="person-image" src="@imageSource" alt="Photo of @_person.Name" />
                            </div>
                        }
                    </Authorized>
                </AuthorizeView>
                <div class="col-md-8">
                    <div class="row">
                        <div class="col">
                            <h3 class="person-title">@_person.Name @_person.Surname</h3>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <span class="person-description">
                                Birthday: @(_person.DayOfBirth?.ToString("dd.MM.") ?? "")
                            </span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <span class="person-description">
                                Nameday: @_person.DayOfNameDay.ToString("dd.MM.")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (_loadFailed)
{
    <p>The person could not be loaded.</p>
}
else
{
    <p>Loading person...</p>
}
<br />
<div class="row">
	<div class="col">
		<a href="/persons" class="btn btn-success">Back</a>
	</div>
</div>
