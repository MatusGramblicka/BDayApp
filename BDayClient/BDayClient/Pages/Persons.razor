@page "/"
@page "/persons"
@using BDayClient.Components

@attribute [Authorize]

<PageTitle>Persons - BDay App</PageTitle>

<div class="row">
	<div class="col-md-5">
		<Search OnSearchChanged="SearchChanged" />
	</div>
	<div class="col-md-5">
		<Sort OnSortChanged="SortChanged" />
	</div>
	<div class="col-md-2">
		<a class="btn btn-success mb-1" href="/createPerson">New Person</a>
	</div>
</div>
<div class="row">
	<div class="col">
		@if (_loadFailed)
		{
			<p>The persons could not be loaded.</p>
		}
		else
		{
			<PersonTable Persons="_persons" OnDelete="DeletePerson" />
		}
	</div>
</div>
<div class="row">
	<div class="col">
		<Pagination MetaData="_metaData" Spread="1" SelectedPage="SelectedPage" />
	</div>
	<div class="col">
		<PageSizeDropDown SelectedPageSize="SetPageSize" />
	</div>
</div>
