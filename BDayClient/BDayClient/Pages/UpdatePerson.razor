@page "/updatePerson/{id:guid}"
@attribute [Authorize]
@using BDayClient.Components

<PageTitle>Update person - BDay App</PageTitle>

<h2>Update Person Form</h2>

@if (_personForUpdate is not null)
{
    <PersonForm Model="_personForUpdate" SubmitText="Update" OnValidSubmit="Update" />
}
else if (_loadFailed)
{
    <p>The person could not be loaded.</p>
}
else
{
    <p>Loading person...</p>
}
<br />
<div class="row">
    <div class="col">
        <a href="/persons" class="btn btn-success">Back</a>
    </div>
</div>
