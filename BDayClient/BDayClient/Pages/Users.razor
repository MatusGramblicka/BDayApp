@page "/users"
@using BDayClient.Components

@attribute [Authorize(Roles = "Administrator")]

<PageTitle>Users - BDay App</PageTitle>

<div class="row">
    <div class="col">
        @if (_loadFailed)
        {
            <p>The users could not be loaded.</p>
        }
        else
        {
            <UsersTable Users="_users"
                        LoggedUser="@_loggedUserName"
                        OnUpdate="UpdateUser"
                        OnRemoveAdminRole="RemoveAdminRole" OnDeleteUser="DeleteUser"
                        OnChange2StepsAuthorization="Change2StepsAuthorization"/>
        }
    </div>
</div>
