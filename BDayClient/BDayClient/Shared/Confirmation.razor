<div class="modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="@_titleId"
     style="display:@_modalDisplay" @ref="_dialog" @onkeydown="OnKeyDown">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="@_titleId">Confirmation</h5>
                <button type="button" class="close" @onclick="Close" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>@BodyMessage</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success"
                        @onclick="() => OnOKClicked.InvokeAsync()">
                    OK
                </button>
                <button type="button" class="btn btn-danger"
                        @onclick="Close">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

@if (_showBackdrop)
{
    <div class="modal-backdrop fade show"></div>
}
