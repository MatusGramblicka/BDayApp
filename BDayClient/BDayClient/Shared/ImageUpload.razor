@* The visually hidden input stays focusable, so the "button" also works with the keyboard. *@
<label class="btn btn-info file-picker mb-0">
    Select a File
    <InputFile OnChange="HandleSelected" accept="image/*" class="sr-only" />
</label>
<span class="image-name">@_fileUploadMessage</span>

@if (ApiUrls.GetImageSource(_imageUrl) is { } imageSource)
{
    <div>
        <img src="@imageSource" class="image-preview" alt="Selected image" />
    </div>
}
