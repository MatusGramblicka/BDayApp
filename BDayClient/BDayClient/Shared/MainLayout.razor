@inherits LayoutComponentBase
@using BDayClient.Components

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <div class="main">
        @* "auth" keeps the bar (log in / log out) visible on narrow screens, see MainLayout.razor.css. *@
        <div class="top-row px-4 auth">
            <AuthLinks />
        </div>

        <div class="content px-4">
            @Body
        </div>

        <BlazoredToasts Position="ToastPosition.TopRight"
                        Timeout="10" />

    </div>
</div>
