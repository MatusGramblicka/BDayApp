<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <Nullable>enable</Nullable>
	  <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>bfa802d8-ed9b-4b97-920d-e7faee8f312a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.2" />
    <PackageReference Include="NLog" Version="6.1.3" />
  </ItemGroup>

	<ItemGroup>
		<Content Include="StaticFiles\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
    <Folder Include="Migrations\AzureSqlMigrations\" />
    <Folder Include="Migrations\PostgreSqlMigrations\" />
    <Folder Include="StaticFiles\Images\" />
  </ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Contracts\Contracts.csproj" />
	  <ProjectReference Include="..\Core\Core.csproj" />
	  <ProjectReference Include="..\EmailService\EmailService.csproj" />
	  <ProjectReference Include="..\Entities\Entities.csproj" />
	  <ProjectReference Include="..\Repository\Repository.csproj" />
	  <!-- The server hosts the Blazor WebAssembly client: publishing the server also publishes the client into wwwroot,
	       so the client no longer has to be published and copied by hand. -->
	  <ProjectReference Include="..\..\BDayClient\BDayClient\BDayClient.csproj" />
	</ItemGroup>

	<!-- Files that only live on the web server. Web Deploy never uploads, overwrites or deletes them,
	     also not with "Remove additional files at destination":
	     - person images uploaded at runtime (StaticFiles\Images)
	     - appsettings*.json and NLog.config, which are not in git: change them on the server (Kudu), not by publishing.
	     (A skip rule skips add, update and delete; Web Deploy from Visual Studio does not support SkipAction.) -->
	<ItemGroup>
	  <MsDeploySkipRules Include="SkipUploadedImagesFolder">
	    <ObjectName>dirPath</ObjectName>
	    <AbsolutePath>\\StaticFiles\\Images$</AbsolutePath>
	  </MsDeploySkipRules>
	  <MsDeploySkipRules Include="SkipUploadedImages">
	    <ObjectName>filePath</ObjectName>
	    <AbsolutePath>\\StaticFiles\\Images\\</AbsolutePath>
	  </MsDeploySkipRules>
	  <MsDeploySkipRules Include="SkipAppSettings">
	    <ObjectName>filePath</ObjectName>
	    <AbsolutePath>(?i)\\appsettings[^\\]*\.json$</AbsolutePath>
	  </MsDeploySkipRules>
	  <MsDeploySkipRules Include="SkipNLogConfig">
	    <ObjectName>filePath</ObjectName>
	    <AbsolutePath>(?i)\\nlog\.config$</AbsolutePath>
	  </MsDeploySkipRules>
	</ItemGroup>

</Project>
